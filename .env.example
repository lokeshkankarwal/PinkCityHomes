# ============================================================
# PinkCityHomes — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── SERVER ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=your-secret-key-at-least-32-chars

# ── MONGODB (Primary Application & Geospatial Database) ──────
MONGODB_URI=mongodb://127.0.0.1:27017/pinkcityhomes

# ── CLOUDINARY (Primary Media Storage for Photos & Avatars) ───
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── AWS S3 (Alternative Storage Architecture) ─────────────────
# Optional fallback if Cloudinary is not configured
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ── SUPERADMIN BOOTSTRAP ─────────────────────────────────────
SUPERADMIN_EMAIL=lokeshkankarwal456@gmail.com
SUPERADMIN_PASSWORD=your-secure-superadmin-password

# ── EMAIL CONFIGURATION (choose ONE provider, keep the other as fallback) ──
#
# 🥇 OPTION A — Gmail SMTP (100% FREE, works on Render, sends to ANY Gmail with NO domain needed)
#    1. Use an existing Gmail account (e.g. pinkcityhomes456@gmail.com)
#    2. Enable 2-Step Verification on the Gmail account
#       https://myaccount.google.com/security
#    3. Generate a 16-char Google "App Password" at:
#       https://myaccount.google.com/apppasswords
#       (select app=Mail, device=Other / Custom)
#    4. Paste that into SMTP_PASS below (without spaces, or with spaces — both work)
#
#    EMAIL_PROVIDER=gmail is the RECOMMENDED default for FREE deployments on Render
#    because it does not require a custom domain nor paid Resend credits.
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-account@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Use the Gmail address itself as the friendly From
SMTP_FROM=PinkCityHomes <your-gmail-account@gmail.com>
EMAIL_FROM=PinkCityHomes <your-gmail-account@gmail.com>

# ── EMAIL CONFIGURATION (Resend HTTPS REST API — secondary / fallback) ─────
# Use only if Gmail SMTP is unavailable.
# NOTE: Resend FREE tier + the default onboarding@resend.dev sender ONLY works
#       when sending TO THE EMAIL YOU USED TO SIGN UP AT RESEND.COM.
#       To send to arbitrary recipients via Resend, you MUST verify a custom domain
#       (paid) at resend.com/domains — this is why Gmail SMTP is preferred for free.
EMAIL_API_KEY=re_your_resend_api_key_here
# EMAIL_FROM=PinkCityHomes <onboarding@resend.dev>   # disabled when using Gmail
EMAIL_VERIFICATION_URL=http://localhost:5173

# ── RATE LIMITING ────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=5
VERIFICATION_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_MAX=5
