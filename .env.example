# ============================================================
# PinkCityHomes — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── SERVER ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=your-secret-key-at-least-32-chars

# ── MONGODB (Primary Application & Geospatial Database) ──────
MONGODB_URI=mongodb://127.0.0.1:27017/pinkcityhomes

# ── CLOUDINARY (Primary Media Storage for Photos & Avatars) ───
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── AWS S3 (Alternative Storage Architecture) ─────────────────
# Optional fallback if Cloudinary is not configured
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ── SUPERADMIN BOOTSTRAP ─────────────────────────────────────
SUPERADMIN_EMAIL=lokeshkankarwal456@gmail.com
SUPERADMIN_PASSWORD=your-secure-superadmin-password

# ── EMAIL CONFIGURATION (Resend HTTPS REST API) ─────────────
# Uses Resend HTTPS API (works on Render Free without SMTP port blocking)
# 1. Sign up at https://resend.com
# 2. Generate an API Key under API Keys tab
# 3. Add key to EMAIL_API_KEY below
EMAIL_API_KEY=re_your_resend_api_key_here
# Note: For free accounts without custom domain verification, use: PinkCityHomes <onboarding@resend.dev>
# After verifying your domain at resend.com/domains, you can use: PinkCityHomes <noreply@yourdomain.com>
EMAIL_FROM=PinkCityHomes <onboarding@resend.dev>
EMAIL_VERIFICATION_URL=http://localhost:5173

# ── RATE LIMITING ────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=5
VERIFICATION_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_MAX=5
