# ============================================================
# PinkCityHomes — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── SERVER ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=your-secret-key-at-least-32-chars

# ── DATABASE ─────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/pinkcityhomes

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ── SUPERADMIN BOOTSTRAP ─────────────────────────────────────
SUPERADMIN_EMAIL=lokeshkankarwal456@gmail.com
SUPERADMIN_PASSWORD=your-secure-superadmin-password

# ── SMTP (Nodemailer Email Verification) ─────────────────────
# For Gmail: smtp.gmail.com, port 587 or 465, with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=lokeshkankarwal456@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=PinkCityHomes <lokeshkankarwal456@gmail.com>
EMAIL_VERIFICATION_URL=http://localhost:5173

# ── RATE LIMITING ────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=5
VERIFICATION_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_MAX=5
