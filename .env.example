# ============================================================
# PinkCityHomes — Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── SERVER ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
JWT_SECRET=your-secret-key-at-least-32-chars

# ── MONGODB (Primary Application & Geospatial Database) ──────
MONGODB_URI=mongodb://127.0.0.1:27017/pinkcityhomes

# ── CLOUDINARY (Primary Media Storage for Photos & Avatars) ───
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── AWS S3 (Alternative Storage Architecture) ─────────────────
# Optional fallback if Cloudinary is not configured
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# ── SUPERADMIN BOOTSTRAP ─────────────────────────────────────
SUPERADMIN_EMAIL=lokeshkankarwal456@gmail.com
SUPERADMIN_PASSWORD=your-secure-superadmin-password

# ── EMAIL CONFIGURATION ──────────────────────────────────────
# Option A: Gmail SMTP with Google App Password (Tutorial: https://www.youtube.com/watch?v=FT-AiOcw-50)
# 1. Enable 2-Step Verification on your Google Account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password for "PinkCityHomes" (16-char code)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=pinkcityhomes456@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM=PinkCityHomes <pinkcityhomes456@gmail.com>

# Option B: Resend HTTPS REST API (Fallback)
EMAIL_API_KEY=
EMAIL_FROM=PinkCityHomes <pinkcityhomes456@gmail.com>
EMAIL_VERIFICATION_URL=http://localhost:5173

# ── RATE LIMITING ────────────────────────────────────────────
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOGIN_RATE_LIMIT_MAX=10
REGISTRATION_RATE_LIMIT_MAX=5
VERIFICATION_RATE_LIMIT_MAX=3
PASSWORD_RESET_RATE_LIMIT_MAX=5
